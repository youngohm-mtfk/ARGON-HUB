-- ANIMATED MENU TOGGLE
local isMenuOpen = true
local isAnimating = false

local function toggleMenu(open: boolean?)
	if isAnimating then return end
	isAnimating = true
	if open == nil then open = not isMenuOpen end
	isMenuOpen = open

	if isMenuOpen then
		window.Visible = true
		windowScale.Scale = 0.82
		window.BackgroundTransparency = 0.8
		TweenService:Create(windowScale, TWEEN, { Scale = 1 }):Play()
		local t = TweenService:Create(window, TWEEN_FAST, { BackgroundTransparency = 0.15 })
		t:Play()
		t.Completed:Connect(function() isAnimating = false end)
	else
		TweenService:Create(windowScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.85 }):Play()
		local t = TweenService:Create(window, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 })
		t:Play()
		t.Completed:Connect(function()
			window.Visible = false
			isAnimating = false
		end)
	end
end

