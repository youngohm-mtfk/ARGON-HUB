-- Dragging
do
	local dragging, dragStart, startPos = false, Vector2.zero, UDim2.new()
	topbar.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = window.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local d = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			window.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then dragging = false end
	end)
end

-- Custom Global Key Listener for Menu Toggle
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	local isMatch = false
	if CFG.menuKey.EnumType == Enum.KeyCode and input.KeyCode == CFG.menuKey then
		isMatch = true
	elseif CFG.menuKey.EnumType == Enum.UserInputType and input.UserInputType == CFG.menuKey then
		isMatch = true
	end
	if isMatch then
		toggleMenu()
	end
end)

-- ===== TABS & SECTIONS =====
local tabs = {}
local groupOrder = 0

local function selectTab(tab)
	for _, t in ipairs(tabs) do
		local active = (t == tab)
		t.page.Visible = active
		TweenService:Create(t.button, TWEEN_FAST, {
			BackgroundTransparency = active and 0.15 or 1,
		}):Play()
		t.icon.TextColor3 = active and Color3.new(1, 1, 1) or C.accent
	end
	titleLabel.Text = tab.name
	subtitleLabel.Text = tab.subtitle
end

local function addGroup(name: string)
	groupOrder += 1
	label(navList, name, 10, C.muted, FONT_BOLD, {
		Size = UDim2.new(1, 0, 0, 22),
		LayoutOrder = groupOrder * 100,
		TextYAlignment = Enum.TextYAlignment.Bottom,
	})
	return groupOrder
end

local function makeSection(page: ScrollingFrame, title: string, subtitle: string)
	local holder = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = #page:GetChildren(),
	}, page)
	make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
	make("UIPadding", { PaddingBottom = UDim.new(0, 14) }, holder)
	label(holder, title, 13, C.text, FONT_BOLD, { Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1 })
	label(holder, subtitle, 12, C.muted, FONT, { Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 2 })

	local card = make("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.panel,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		LayoutOrder = 3,
	}, holder)
	corner(card, 10)
	stroke(card, C.accent, 1, 0.8)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)

	local count = 0
	local section = {}

	local function newRow(titleText: string, desc: string?)
		count += 1
		local r = make("Frame", {
			Size = UDim2.new(1, 0, 0, desc and 54 or 44),
			BackgroundTransparency = 1,
			LayoutOrder = count,
		}, card)
		if count > 1 then
			make("Frame", {
				Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = C.accent,
				BackgroundTransparency = 0.88,
				BorderSizePixel = 0,
			}, r)
		end
		label(r, titleText, 13, C.text, FONT_MED, {
			Position = UDim2.fromOffset(14, desc and 9 or 13),
			Size = UDim2.new(1, -220, 0, 16),
		})
		if desc then
			label(r, desc, 12, C.muted, FONT, {
				Position = UDim2.fromOffset(14, 27),
				Size = UDim2.new(1, -220, 0, 16),
			})
		end
		local ctl = make("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -14, 0.5, 0),
			Size = UDim2.fromOffset(210, 28),
			BackgroundTransparency = 1,
		}, r)
		return ctl
	end

	-- TOGGLE SWITCH
	function section:Toggle(name: string, desc: string?, default: boolean, callback: ((boolean) -> ())?)
		local ctl = newRow(name, desc)
		local state = default
		local track = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(38, 22),
			BackgroundColor3 = state and C.accent or C.off,
			BackgroundTransparency = 0.1,
			Text = "",
			AutoButtonColor = false,
		}, ctl)
		corner(track, 11)
		local knob = make("Frame", {
			Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
			Size = UDim2.fromOffset(18, 18),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, track)
		corner(knob, 9)
		track.MouseButton1Click:Connect(function()
			state = not state
			TweenService:Create(track, TWEEN_FAST, { BackgroundColor3 = state and C.accent or C.off }):Play()
			TweenService:Create(knob, TWEEN_FAST, {
				Position = state and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2),
			}):Play()
			if callback then callback(state) end
		end)
	end

	-- SLIDER
	function section:Slider(name: string, desc: string?, default: number, min: number, max: number, suffix: string?, callback: ((number) -> ())?)
		local ctl = newRow(name, desc)
		local value = default
		local suff = suffix or ""
		local valueLabel = label(ctl, tostring(value) .. suff, 12, C.muted, FONT, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(48, 16),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		local hit = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.new(1, -54, 0, 24),
			BackgroundTransparency = 1,
			Active = true,
		}, ctl)
		local bar = make("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.new(1, 0, 0, 4),
			BackgroundColor3 = C.off,
			BorderSizePixel = 0,
		}, hit)
		corner(bar, 2)
		local fill = make("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = C.accent,
			BorderSizePixel = 0,
		}, bar)
		corner(fill, 2)
		local knob = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, bar)
		corner(knob, 8)

		local function render()
			local a = math.clamp((value - min) / (max - min), 0, 1)
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.fromScale(a, 0.5)
			valueLabel.Text = tostring(value) .. suff
		end
		local function setFromX(x: number)
			local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
			local v = math.floor(min + a * (max - min) + 0.5)
			if v ~= value then
				value = v
				if callback then callback(value) end
			end
			render()
		end
		render()

		local dragging = false
		hit.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging = true
				setFromX(input.Position.X)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				setFromX(input.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then dragging = false end
		end)
	end

	-- CUSTOM DYNAMIC KEYBIND PICKER
	function section:Keybind(name: string, desc: string?, defaultKey: any, callback: ((any) -> ())?)
		local ctl = newRow(name, desc)
		local currentKey = defaultKey
		local isListening = false

		local btn = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(130, 26),
			BackgroundColor3 = C.row,
			BackgroundTransparency = 0.2,
			Text = "[ " .. getKeyDisplayName(currentKey) .. " ]",
			TextColor3 = C.accent,
			TextSize = 12,
			Font = FONT_BOLD,
			AutoButtonColor = true,
		}, ctl)
		corner(btn, 7)
		local btnStroke = stroke(btn, C.accent, 1, 0.7)

		btn.MouseButton1Click:Connect(function()
			if isListening then return end
			isListening = true
			btn.Text = "[ Press Any Key... ]"
			btn.TextColor3 = Color3.fromRGB(255, 220, 80)
			btnStroke.Transparency = 0.1
			btnStroke.Color = Color3.fromRGB(255, 220, 80)

			local conn: RBXScriptConnection
			conn = UserInputService.InputBegan:Connect(function(inp, gpe)
				if inp.UserInputType == Enum.UserInputType.MouseMovement then return end
				local selected = nil

				if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode ~= Enum.KeyCode.Unknown then
					selected = inp.KeyCode
				elseif inp.UserInputType == Enum.UserInputType.MouseButton1
					or inp.UserInputType == Enum.UserInputType.MouseButton2
					or inp.UserInputType == Enum.UserInputType.MouseButton3 then
					selected = inp.UserInputType
				end

				if selected then
					conn:Disconnect()
					currentKey = selected
					btn.Text = "[ " .. getKeyDisplayName(currentKey) .. " ]"
					btn.TextColor3 = C.accent
					btnStroke.Transparency = 0.7
					btnStroke.Color = C.accent
					isListening = false
					if callback then callback(currentKey) end
				end
			end)
		end)
	end

	-- DROPDOWN CYCLER
	function section:Dropdown(name: string, desc: string?, options: {string}, defaultIndex: number?, callback: ((string) -> ())?)
		local ctl = newRow(name, desc)
		local index = defaultIndex or 1
		local btn = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(130, 26),
			BackgroundColor3 = C.row,
			BackgroundTransparency = 0.2,
			Text = options[index] .. "  ⌄",
			TextColor3 = C.text,
			TextSize = 12,
			Font = FONT_MED,
			AutoButtonColor = true,
		}, ctl)
		corner(btn, 7)
		stroke(btn, C.accent, 1, 0.8)
		btn.MouseButton1Click:Connect(function()
			index = index % #options + 1
			btn.Text = options[index] .. "  ⌄"
			if callback then callback(options[index]) end
		end)
	end

	-- ACTION BUTTON
	function section:Button(name: string, desc: string?, buttonText: string, callback: (() -> ())?)
		local ctl = newRow(name, desc)
		local btn = make("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			Size = UDim2.fromOffset(110, 26),
			BackgroundColor3 = C.accent,
			BackgroundTransparency = 0.1,
			Text = buttonText,
			TextColor3 = Color3.fromRGB(8, 12, 24),
			TextSize = 12,
			Font = FONT_BOLD,
		}, ctl)
		corner(btn, 7)
		btn.MouseButton1Click:Connect(function()
			if callback then callback() end
		end)
	end

	return section
end

local function addTab(groupId: number, name: string, subtitle: string, iconGlyph: string)
	local index = 0
	for _, t in ipairs(tabs) do
		if t.group == groupId then index += 1 end
	end

	local button = make("TextButton", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = C.accent,
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = groupId * 100 + index + 1,
	}, navList)
	corner(button, 7)
	local icon = label(button, iconGlyph, 14, C.accent, FONT_BOLD, {
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.fromOffset(20, 30),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	label(button, name, 13, C.text, FONT_MED, {
		Position = UDim2.fromOffset(34, 0),
		Size = UDim2.new(1, -40, 1, 0),
	})

	local page = make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.accent,
		ScrollBarImageTransparency = 0.6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, content)
	make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, page)
	make("UIPadding", {
		PaddingTop = UDim.new(0, 16), PaddingBottom = UDim.new(0, 16),
		PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 20),
	}, page)

	local tab = { name = name, subtitle = subtitle, button = button, icon = icon, page = page, group = groupId }
	table.insert(tabs, tab)
	button.MouseButton1Click:Connect(function() selectTab(tab) end)

	function tab:Section(title: string, sub: string)
		return makeSection(page, title, sub)
	end
	return tab
end

