local function getKeyDisplayName(k: any): string
	if typeof(k) == "EnumItem" then
		if k.EnumType == Enum.KeyCode then
			return k.Name
		elseif k.EnumType == Enum.UserInputType then
			if k == Enum.UserInputType.MouseButton1 then return "Left Click"
			elseif k == Enum.UserInputType.MouseButton2 then return "Right Click"
			elseif k == Enum.UserInputType.MouseButton3 then return "Middle Click"
			end
			return k.Name
		end
	end
	return tostring(k)
end

-- ===== HELPERS =====
local function make(class: string, props: {[string]: any}, parent: Instance?): any
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		(inst :: any)[k] = v
	end
	inst.Parent = parent
	return inst
end

local function corner(inst: Instance, r: number)
	make("UICorner", { CornerRadius = UDim.new(0, r) }, inst)
end

local function stroke(inst: Instance, color: Color3, thickness: number?, trans: number?)
	return make("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = trans or 0.7,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function label(parent: Instance, text: string, size: number, color: Color3, font: Enum.Font?, props: {[string]: any}?): TextLabel
	local p = {
		BackgroundTransparency = 1,
		Text = text,
		TextSize = size,
		TextColor3 = color,
		Font = font or FONT,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}
	if props then
		for k, v in pairs(props) do p[k] = v end
	end
	return make("TextLabel", p, parent)
end

local function isPress(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

